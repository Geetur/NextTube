# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=media
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/media

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=media.transcode.requested
KAFKA_DEAD_LETTER_TOPIC=media.transcode.dlq
KAFKA_CONSUMER_GROUP=worker-group

# Delivery and local worker scaling
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAYS_SECONDS=30,120,600
AUTOSCALER_MIN_WORKERS=1
AUTOSCALER_MAX_WORKERS=3
AUTOSCALER_TARGET_LAG_PER_WORKER=1

# MinIO (S3-compatible)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=media

# API
ENV=dev
